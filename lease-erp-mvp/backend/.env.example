# Database
DATABASE_URL="postgresql://user:password@hostname:5432/lease_erp?schema=public"

# API Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.lease-erp.com
AUTH0_ISSUER_URL=https://your-tenant.auth0.com/

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=lease-erp-documents
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# CORS Settings
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app

# Microservices Ports (for development)
CRM_SERVICE_PORT=4001
QUOTE_SERVICE_PORT=4002
CONTRACT_SERVICE_PORT=4003
ASSET_SERVICE_PORT=4004
DOCUMENT_SERVICE_PORT=4005

# JWT Configuration (for internal service communication)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# Email Configuration (for Phase 2)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# FROM_EMAIL=noreply@lease-erp.com

# Redis (for caching - Phase 2)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Stripe (for Phase 2)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
